# ----- Polymarket API base URLs (override only if Polymarket moves them) -----
GAMMA_API_BASE=https://gamma-api.polymarket.com
DATA_API_BASE=https://data-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
# Polymarket's public ranking API. Exposes /profit and /volume with windows
# 1d|7d|30d|all. The bot uses this to auto-discover the rolling top-trader
# pool with zero manual setup.
LEADERBOARD_API_BASE=https://lb-api.polymarket.com

# ----- Polling -----
# How often the watch daemon refreshes activity for tracked wallets (seconds).
POLL_INTERVAL_SEC=20
# How often the leaderboard is recomputed (seconds). PnL ranking is expensive,
# so keep this much higher than POLL_INTERVAL_SEC.
LEADERBOARD_REFRESH_SEC=900
# Top N traders to track from the leaderboard.
TOP_N=10

# ----- WhatsApp via Twilio -----
# Get these from https://console.twilio.com after enabling the WhatsApp sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox sender is "whatsapp:+14155238886"; production senders look
# like "whatsapp:+15551234567".
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated recipients, e.g. "whatsapp:+15555550123,whatsapp:+447700900123"
WHATSAPP_TO=

# ----- Auto-execute (DANGEROUS: real money) -----
# Master kill switch. Leave false until you've watched the bot for days and
# tested with tiny sizes.
AUTO_EXECUTE=false
# Polygon private key of the funded wallet that will mirror trades. NEVER
# commit this. NEVER paste it into a chat. Use a dedicated wallet with only
# what you can afford to lose.
TRADER_PRIVATE_KEY=
# Maximum USDC to spend per single mirrored trade.
MAX_TRADE_USDC=25
# Maximum total USDC across all open mirrored positions.
MAX_OPEN_USDC=250
# How to size mirrored orders relative to the leader's order:
#   fixed   -> always MAX_TRADE_USDC (capped)
#   percent -> percentage of the leader's notional, capped by MAX_TRADE_USDC
SIZING_MODE=fixed
SIZING_PERCENT=1
# Skip mirroring trades older than this many seconds (avoid catch-up storms
# when the bot restarts).
MAX_TRADE_AGE_SEC=120

# ----- Sure-thing scanner -----
# Minimum implied probability (orderbook best-bid) to flag a market as a
# near-sure-thing. 0.97 = "97%+ likely" per the market itself. Lower for more
# candidates / more tail risk.
SURE_THING_THRESHOLD=0.97
# Only flag markets resolving within this many hours, so capital cycles daily.
SURE_THING_MAX_HOURS=24
# How far back to scan for pool-wallet trades on each candidate market when
# computing the smart-money signal.
SURE_THING_SMART_LOOKBACK_HOURS=24
# Cadence of the scanner pass (seconds). 300s = every 5 min; safe for gamma.
SURE_THING_SCAN_INTERVAL_SEC=300
# How the bot acts on a candidate:
#   surface  -> show in dashboard only, never execute (recommended)
#   confirm  -> auto-execute candidates whose smart-money score is GREEN
#   all      -> auto-execute every candidate that passes SMART_MONEY_RULE
# Execution always also requires AUTO_EXECUTE=true.
SURE_THING_EXEC_MODE=surface
# How the smart-money overlay filters candidates:
#   required  -> only candidates where pool wallets net-buy the sure side
#                pass through (strictest, recommended)
#   veto      -> candidate passes unless pool wallets are heavily on the
#                OPPOSITE side
#   advisory  -> every priced candidate passes; signal shown as green/amber/red
SURE_THING_SMART_MONEY_RULE=required
# Slippage (basis points) allowed above best ask when placing sure-thing buys.
# 50 = 0.5%. Limit price is also clamped to <= 0.99.
SURE_THING_SLIPPAGE_BPS=50
# How often (seconds) to sweep gamma for newly-resolved markets and mark
# tracked positions W/L for the hit-rate leaderboard.
HIT_RATE_SWEEP_SEC=1800

# ----- Dashboard -----
DASHBOARD_PORT=8787

# ----- Logging -----
LOG_LEVEL=info
